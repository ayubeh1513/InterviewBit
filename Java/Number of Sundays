public class Solution {
    public int solve(String A, int B) {
        int startDayValue = 0;

        if (A.equals("Monday")) startDayValue = 1;
        else if (A.equals("Tuesday")) startDayValue = 2;
        else if (A.equals("Wednesday")) startDayValue = 3;
        else if (A.equals("Thursday")) startDayValue = 4;
        else if (A.equals("Friday")) startDayValue = 5;
        else if (A.equals("Saturday")) startDayValue = 6;
        else if (A.equals("Sunday")) startDayValue = 7;

        int firstSunday = (7 - startDayValue + 7) % 7 + 1;

        if (firstSunday > B) {
            return 0;
        }

        return 1 + (B - firstSunday) / 7;
    }
}
